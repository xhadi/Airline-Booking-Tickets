# 1. Database Configuration and Sensitive Information
# NEVER commit database credentials or API keys
backend/config/db.php
backend/config/config.php
.env

# 2. IDE and Editor Folders
# These are generated by VSCode, PHPStorm, etc., and aren't part of the code
.vscode/
.idea/
*.sublime-workspace

# 3. OS Generated Files
# Files created by Windows or macOS automatically
.DS_Store
Thumbs.db
desktop.ini

# 4. Logs and Temporary Files
# If your PHP scripts generate error logs, you shouldn't commit them
*.log
/tmp
/temp

# 5. Agent files
AGENTS.md
docs/*
.superpowers/
